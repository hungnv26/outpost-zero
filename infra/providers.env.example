# Copy to infra/providers.env (gitignored) and fill in the key for the provider a team uses:
#   scripts/arena.sh up B=anthropic:claude-sonnet-5-5
# Hermes calls each provider's OpenAI-compatible chat endpoint with tools.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
OPENROUTER_API_KEY=
# Any other OpenAI-compatible provider: <NAME>_API_KEY and <NAME>_BASE_URL, then B=<name>:<model>.
