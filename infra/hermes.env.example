# Hermes Synapse config for Outpost Zero.
# scripts/setup.sh copies this to vendor/hermes-synapse/.env (Hermes mounts it from there).
#
# Default: local Ollama (free, no keys). To use a hosted model instead, set
# LLM_API_BASE + OPENROUTER_API_KEY to any OpenAI-compatible endpoint, e.g.
#   LLM_API_BASE=https://openrouter.ai/api/v1
#   OPENROUTER_API_KEY=sk-or-...
#   LLM_MODEL=anthropic/claude-haiku-4.5
# and set the AGENT_MODEL_* / LLM_FALLBACK_MODEL lines to the same model.

LLM_API_BASE=http://host.docker.internal:11434/v1
OPENROUTER_API_KEY=ollama-local
LLM_MODEL=agentrts-qwen3
LLM_FALLBACK_MODEL=agentrts-qwen3
AGENT_MODEL_RESEARCH=agentrts-qwen3
AGENT_MODEL_CODE=agentrts-qwen3
AGENT_MODEL_ANALYST=agentrts-qwen3
AGENT_MODEL_PLANNER=agentrts-qwen3
COMPLEXITY_ROUTING=false

PORT=8000
SEARXNG_URL=http://searxng:8080
MARKET_DATA_PROVIDER=http
DATABASE_URL=postgresql://postgres:postgres@db:5432/hermes
