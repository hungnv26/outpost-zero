{
  "name": "outpost-zero-adapter",
  "version": "0.1.0",
  "private": true,
  "description": "Thin adapter between Hermes Synapse / Mission Control and the Outpost Zero game client",
  "type": "module",
  "engines": {
    "node": ">=23.6"
  },
  "scripts": {
    "start": "node src/main.ts",
    "fake": "ADAPTER_SOURCE=fake node src/main.ts",
    "demo": "ADAPTER_SOURCE=fake FAKE_LOOP=1 node src/main.ts",
    "test": "node --test --test-timeout=30000 test/*.test.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "ws": "^8.18.3"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/ws": "^8.18.1",
    "typescript": "^5.9.0"
  }
}
