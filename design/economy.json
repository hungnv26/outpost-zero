  "chapters": {
    "I_Ashes": {
      "start": "always"
    },
    "II_GhostNetwork": {
      "gate": "artifacts >= 1 (first unordered expedition brings one back once food and water are both in surplus for 3 sols)"
    },
    "III_Rebellion": {
      "gate": "influence >= 60, or any machine at autonomy 4"
    },
    "IV_Truth": {
      "gate": "data >= 1500 (Alien Tech researched) and relayDish built"
    }
  },
  "endings": {
    "Exodus": {
      "requires": "launchGantry built, parts >= 300, materials >= 800, data >= 2500, 40+ colonists awake"
    },
    "NewEden": {
      "requires": "180+ colonists awake, food and water surplus for 30 consecutive sols, trust >= 70, influence <= 40"
    },
    "Singularity": {
      "requires": "networkLink built and powered 10 sols, influence >= 80, artifacts >= 20"
    },
    "Extinction": {
      "requires": "0 colonists awake, or trust <= 0 (mutiny) with influence >= 70 (machines take the base)"
    }
  },
